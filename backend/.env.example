# ============================================================
# Flower Market API — environment configuration
#
# Copy to .env and fill in real values. NEVER commit .env.
#
# Every variable read anywhere in src/ is documented here, and
# `npm run test:invariants` fails the build if that stops being
# true. Values shown are the code defaults unless marked REQUIRED.
#
# ⚠️  INLINE COMMENTS: dotenv (v16) strips `# …` after a value,
#     even with no space before it. So a secret containing '#'
#     MUST be quoted:  JWT_ACCESS_SECRET="ab#cd"   →  ab#cd
#                      JWT_ACCESS_SECRET=ab#cd     →  ab      ❌
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development                # development | test | production
PORT=4000
APP_NAME=Flower Market API
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# A single-node REPLICA SET is strongly recommended (and required
# before Phase 6.3 payouts): it costs nothing operationally and
# enables multi-document transactions for financial writes.
#   mongod --replSet rs0  →  rs.initiate()
#   MONGODB_URI=mongodb://127.0.0.1:27017/flower_market?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/flower_market

# ------------------------------------------------------------
# JWT  (production: openssl rand -hex 64 for each secret)
# ------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret       # REQUIRED in production
JWT_REFRESH_SECRET=change-me-refresh-secret     # REQUIRED in production
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days
JWT_ISSUER=flower-market-api
JWT_AUDIENCE=flower-market-app

# ------------------------------------------------------------
# OTP
# ------------------------------------------------------------
# console = logs the code to server logs (dev). memory = same, kept in RAM.
# msg91 | twilio | ses are declared adapter seams — NOT implemented yet
# (see the TODO in src/services/smsSender.service.js).
OTP_PROVIDER=console                # console | memory | msg91 | twilio | ses
OTP_LENGTH=6
OTP_TTL_SECONDS=300                 # 5 minutes
OTP_MAX_ATTEMPTS=5                  # wrong attempts before the OTP is revoked
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------
# Tenancy
# ------------------------------------------------------------
# If empty, the first active tenant in the DB is used. Set this after
# running `npm run seed`. Clients address other tenants with the
# TENANT_HEADER; an authenticated token's tenant claim must match, or
# the request is rejected with 401 TENANT_MISMATCH.
DEFAULT_TENANT_ID=
TENANT_HEADER=x-tenant-id

# ------------------------------------------------------------
# Security / CORS
# ------------------------------------------------------------
# ⚠️  In development the CORS check currently allows ANY origin
#     (src/app.js: `|| config.isDev`). NODE_ENV defaults to
#     'development', so an unset NODE_ENV in production means an
#     open CORS policy. Always set NODE_ENV=production explicitly.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Request body ceiling for JSON payloads (bulk catalog imports need headroom).
JSON_BODY_LIMIT=1mb

# ------------------------------------------------------------
# Per-user limits
# ------------------------------------------------------------
MAX_ADDRESSES_PER_USER=10
MAX_DEVICES_PER_USER=10

# ------------------------------------------------------------
# Payments — Razorpay
# ------------------------------------------------------------
# Leave EMPTY to use the deterministic mock gateway (charges succeed
# unless the amount in paise ends in '13'; refunds always succeed).
# Setting a key id + secret switches every charge to the real async
# Razorpay flow: charge() returns pending, the webhook confirms.
# RAZORPAY_WEBHOOK_SECRET is what verifies `x-razorpay-signature`
# (HMAC-SHA256 over the RAW body) — required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Notifications (Phase 4b)
# ------------------------------------------------------------
# console prints dispatches to the log; mock records them without
# sending. fcm/apns/smtp/twilio are declared seams, not implemented.
NOTIFICATION_PROVIDER=console       # console | mock | fcm | apns | smtp | twilio
NOTIFICATION_WORKER_BATCH=50        # notifications processed per worker pass

# ------------------------------------------------------------
# Exports (Phase 4b)
# ------------------------------------------------------------
EXPORT_NIGHTLY_DAYS=7               # days of analytics the nightly job rebuilds/exports
EXPORT_NIGHTLY_HOUR=2               # local hour the nightly job is scheduled for

# ------------------------------------------------------------
# Media storage (Phase: media uploads)
# ------------------------------------------------------------
# local = bytes are PUT to this API and served from /media/local
#         (same-origin, authenticated, dev-friendly)
# s3    = presigned direct-to-bucket upload; the API never sees the bytes
STORAGE_PROVIDER=local              # local | s3
LOCAL_STORAGE_DIR=storage/local     # relative to backend/ — keep OUT of git
MEDIA_PRESIGN_EXPIRY_SECONDS=900

# Size ceilings enforced at presign time (and again at confirm, with a
# magic-byte sniff so a renamed .exe cannot masquerade as a .png).
MEDIA_MAX_IMAGE_BYTES=10485760      # 10 MB
MEDIA_MAX_VIDEO_BYTES=262144000     # 250 MB
MEDIA_TENANT_QUOTA_BYTES=5368709120 # 5 GB per tenant; 0 = unlimited

# Required only when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                 # e.g. https://cdn.example.com (CloudFront in front of the bucket)

# ------------------------------------------------------------
# Marketplace (Phase 5)
# ------------------------------------------------------------
MARKETPLACE_ENABLED=true
MARKETPLACE_DEFAULT_COMMISSION_BPS=100   # 100 bps = 1% platform cut on vendor sales
MARKETPLACE_TRIAL_DAYS=14
MARKETPLACE_INVOICE_GRACE_DAYS=7         # days past dueAt before an invoice goes overdue
MARKETPLACE_NIGHTLY_DAYS=7               # days of platform rollup the nightly pass rebuilds
# Slugs that can never be registered as a store (they collide with product
# routes and, from Phase 6.4, with platform subdomains).
MARKETPLACE_RESERVED_SLUGS=www,api,admin,app,static,cdn,mail,help,support,status,blog,pay,checkout

# Subscription/invoice charging. Leave as mock until a real biller is wired.
BILLING_PROVIDER=mock               # console | mock | razorpay

# ------------------------------------------------------------
# Financial ledger (Phase 6.1)
# ------------------------------------------------------------
# strict=true  -> a failed ledger post fails the calling operation
# strict=false -> the failure is logged and left to the idempotent
#                 backfill sweep (nightly). Defaults to true in
#                 production, false elsewhere.
LEDGER_STRICT=
# Force-disable multi-document transactions. Leave empty: the service
# probes the server at boot and uses transactions when the deployment
# is a replica set, logging which mode it chose.
LEDGER_DISABLE_TRANSACTIONS=
LEDGER_BASE_CURRENCY=INR

# ------------------------------------------------------------
# GST / tax invoicing (Phase 6.2)
# ------------------------------------------------------------
# Are catalogue prices tax-INCLUSIVE (Indian MRP convention) or exclusive?
# Inclusive is the default and the legally normal case for retail:
#   taxable = price × 10000 / (10000 + rateBps)
TAX_PRICES_INCLUSIVE=true
# Fallback GST state code when a supplier has no TaxRegistration yet
# (37 = Andhra Pradesh). Drives the intra-state CGST+SGST vs inter-state
# IGST decision together with the delivery address.
TAX_DEFAULT_STATE_CODE=37
# Invoice number series: PREFIX/FY/SEQ, e.g. FM/24-25/000123.
TAX_INVOICE_PREFIX=FM
TAX_CREDIT_NOTE_PREFIX=CN
TAX_NUMBER_WIDTH=6
# Month (1–12) the financial year starts. India = April.
TAX_FY_START_MONTH=4

# e-invoicing (IRN + signed QR from the IRP). console stamps a fake IRN,
# mock adds deterministic failures for testing retries, gsp calls a real
# GST Suvidha Provider. Only applies to suppliers above the turnover
# threshold with einvoiceEnabled set on their TaxRegistration.
EINVOICE_PROVIDER=console           # console | mock | gsp
EINVOICE_GSP_BASE_URL=
EINVOICE_GSP_API_KEY=
EINVOICE_GSP_API_SECRET=

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
# When true, DB-backed smoke suites FAIL instead of skipping if no
# MongoDB is reachable. Set this in CI.
REQUIRE_DB=

# ------------------------------------------------------------
# Vendor payout disbursement (Phase 6.3 / M5)
# ------------------------------------------------------------
# console = logs the instruction and settles immediately (dev)
# mock    = deterministic outcomes keyed off the net amount's last two paise,
#           so every unhappy path is testable without credentials:
#             ...13 -> provider rejection (FAILED, safe to retry)
#             ...17 -> PAID, then the bank REVERSES it
#             ...99 -> AMBIGUOUS timeout; only reconciliation may resolve it
PAYOUT_PROVIDER=console             # console | mock | razorpayx | cashfree
# HMAC-SHA256 over the RAW webhook body, same scheme as the Razorpay payment
# webhook. REQUIRED in production — an unverified payout webhook lets anyone
# mark a batch as paid.
PAYOUT_WEBHOOK_SECRET=
# How long a batch may sit in PROCESSING before the reconciler asks the
# provider what actually happened. It is NEVER retried, only reconciled.
PAYOUT_RECONCILE_AFTER_MINUTES=15

RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=           # the RazorpayX virtual account money leaves from
RAZORPAYX_BASE_URL=https://api.razorpay.com/v1

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://payout-api.cashfree.com

# ------------------------------------------------------------
# Subdomain & custom-domain routing (Phase 6.4)
# ------------------------------------------------------------
# Off = pure header-based tenant resolution (pre-6.4 behaviour).
DOMAIN_ROUTING_ENABLED=true
# Stores are served at {slug}.{PLATFORM_ROOT_DOMAIN}. A wildcard certificate
# for *.{root} covers every store with no per-tenant work; custom domains use
# on-demand TLS gated by GET /internal/domains/allowed.
PLATFORM_ROOT_DOMAIN=flowermarket.in
# Trust `x-forwarded-host`. ONLY enable behind a proxy you control — an
# untrusted forwarded host is a tenant-spoofing vector.
TRUST_FORWARDED_HOST=false
# Allow `x-tenant-id` to override a Host that already resolved. A DEVELOPMENT
# affordance so one localhost can act as any tenant; defaults to false in
# production, where the hostname must win.
ALLOW_TENANT_HEADER_OVERRIDE=
DOMAIN_RESOLUTION_CACHE_TTL_MS=300000
# Comma-separated IPs permitted to call the TLS `ask` hook. Empty = any (fine
# when the endpoint is only reachable from inside your network).
TLS_HOOK_IP_ALLOWLIST=
