# ============================================================
# Flower Market API — environment configuration
# Copy to .env and fill in real values. Never commit .env
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000
APP_NAME=Flower Market API
CLIENT_URL=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/flower_market

# ---- JWT (use strong random secrets in production: openssl rand -hex 64) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days
JWT_ISSUER=flower-market-api
JWT_AUDIENCE=flower-market-app

# ---- OTP ----
# provider: console | memory | msg91 | twilio | ses   (console = logs code to server logs, good for dev)
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300                 # 5 minutes
OTP_MAX_ATTEMPTS=5                  # wrong attempts before the OTP is revoked
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Tenancy ----
# If empty, the first active tenant in DB is used. Set this after running `npm run seed`.
DEFAULT_TENANT_ID=
TENANT_HEADER=x-tenant-id

# ---- Security / CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- Razorpay (Phase: payments — fill when wiring checkout) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
