# ============================================================
# Flower Market API — environment configuration
#
# Copy to .env and fill in real values. NEVER commit .env.
#
# Every variable read anywhere in src/ is documented here, and
# `npm run test:invariants` fails the build if that stops being
# true. Values shown are the code defaults unless marked REQUIRED.
#
# ⚠️  INLINE COMMENTS: dotenv (v16) strips `# …` after a value,
#     even with no space before it. So a secret containing '#'
#     MUST be quoted:  JWT_ACCESS_SECRET="ab#cd"   →  ab#cd
#                      JWT_ACCESS_SECRET=ab#cd     →  ab      ❌
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development                # development | test | production
PORT=4000
APP_NAME=Flower Market API
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# A single-node REPLICA SET is strongly recommended (and required
# before Phase 6.3 payouts): it costs nothing operationally and
# enables multi-document transactions for financial writes.
#   mongod --replSet rs0  →  rs.initiate()
#   MONGODB_URI=mongodb://127.0.0.1:27017/flower_market?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/flower_market

# ------------------------------------------------------------
# JWT  (production: openssl rand -hex 64 for each secret)
# ------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret       # REQUIRED in production
JWT_REFRESH_SECRET=change-me-refresh-secret     # REQUIRED in production
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days
JWT_ISSUER=flower-market-api
JWT_AUDIENCE=flower-market-app

# ------------------------------------------------------------
# OTP — two slots, because no single vendor covers phone + email
# ------------------------------------------------------------
# PHONE slot. console = logs the code to server stdout (dev only, refuses to
# boot in production). memory = same, held in RAM. msg91 and twilio call their
# live APIs and are the production choices.
OTP_PROVIDER=console                # console | memory | msg91 | twilio

# EMAIL slot. smtp sends through a real relay (SES/SendGrid/Postmark/Mailgun/
# Gmail). ses is a declared seam with NO implementation — production boot
# refuses it instead of letting the first send crash.
# Defaults to OTP_PROVIDER, so a phone-only setup needs nothing here.
OTP_EMAIL_PROVIDER=smtp             # console | memory | smtp | ses(seam)

# Comma-separated channels that must all be covered at boot. The app really
# does use both — login sends a PHONE OTP and signup sends an EMAIL one — so the
# default demands both slots resolve. Set to `phone` only if you have removed
# the email-OTP signup path.
OTP_REQUIRED_CHANNELS=phone,email

# Required when OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Required when OTP_PROVIDER=twilio (accountSid is derived from the API key)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ------------------------------------------------------------
# SMTP — real email transport (OTP_EMAIL_PROVIDER=smtp,
# NOTIFICATION_EMAIL_PROVIDER=smtp). Works with any RFC-5321 relay:
# AWS SES, SendGrid, Postmark, Mailgun, Gmail, or a self-hosted server.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587                       # 587 STARTTLS | 465 implicit TLS
SMTP_SECURE=false                   # true = connect over TLS immediately (port 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Flower Market <orders@yourdomain.com>"
SMTP_TIMEOUT_MS=10000
OTP_LENGTH=6
OTP_TTL_SECONDS=300                 # 5 minutes
OTP_MAX_ATTEMPTS=5                  # wrong attempts before the OTP is revoked
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------
# Tenancy
# ------------------------------------------------------------
# If empty, the first active tenant in the DB is used. Set this after
# running `npm run seed`. Clients address other tenants with the
# TENANT_HEADER; an authenticated token's tenant claim must match, or
# the request is rejected with 401 TENANT_MISMATCH.
DEFAULT_TENANT_ID=
TENANT_HEADER=x-tenant-id

# ------------------------------------------------------------
# Security / CORS
# ------------------------------------------------------------
# ⚠️  In development the CORS check currently allows ANY origin
#     (src/app.js: `|| config.isDev`). NODE_ENV defaults to
#     'development', so an unset NODE_ENV in production means an
#     open CORS policy. Always set NODE_ENV=production explicitly.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Request body ceiling for JSON payloads (bulk catalog imports need headroom).
JSON_BODY_LIMIT=1mb

# ------------------------------------------------------------
# Per-user limits
# ------------------------------------------------------------
MAX_ADDRESSES_PER_USER=10
MAX_DEVICES_PER_USER=10

# ------------------------------------------------------------
# Payments — Razorpay
# ------------------------------------------------------------
# Leave EMPTY to use the deterministic mock gateway (charges succeed
# unless the amount in paise ends in '13'; refunds always succeed).
# Setting a key id + secret switches every charge to the real async
# Razorpay flow: charge() returns pending, the webhook confirms.
# RAZORPAY_WEBHOOK_SECRET is what verifies `x-razorpay-signature`
# (HMAC-SHA256 over the RAW body) — required in production.
# mock (default when keys empty) | razorpay. Production boot refuses mock.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dual-write rupee totals as *Paise siblings on cart/quote/order/wallet views.
# Default on. Set false only to restore the pre-Wave-2 payload shape.
MONEY_DUAL_WRITE_PAISE=true

# ------------------------------------------------------------
# Cash on delivery
# ------------------------------------------------------------
# COD never calls a gateway: the order is CONFIRMED and stocked immediately,
# the receivable is booked to `cod_receivable`, and the rider settles it at the
# door (DR cash_on_hand / CR cod_receivable). Set COD_ENABLED=false to switch
# cash off without a deploy — the storefront bootstrap publishes the flag, so
# the option disappears from checkout instead of failing later.
COD_ENABLED=true
# Risk cap in PAISE (500000 = Rs 5,000). Cash is an unsecured credit line to a
# stranger; above this the order must be prepaid. 0 disables the cap.
COD_MAX_AMOUNT_PAISE=500000
# Flat handling fee in PAISE, added to the total when the customer pays cash.
# Carrying cash costs real money (a rider with notes in a bag, a remittance run,
# theft risk). Default 0 so enabling COD never silently changes a price.
COD_FEE_PAISE=0

# ------------------------------------------------------------
# Notifications (Phase 4b)
# ------------------------------------------------------------
# Base provider, used for any channel that has no explicit provider below.
# console prints dispatches to the log and mock records them without sending —
# both are dev doubles and production boot refuses them.
NOTIFICATION_PROVIDER=console       # console | mock | fcm | smtp | msg91 | twilio
NOTIFICATION_WORKER_BATCH=50        # notifications processed per worker pass
NOTIFICATION_FROM_EMAIL=notifications@yourdomain.com

# Per-channel overrides. A vendor that only serves one channel must not be
# handed another: fcm cannot send email, and smtp cannot send SMS.
NOTIFICATION_PUSH_PROVIDER=fcm      # fcm | console | mock  (apns is a seam)
NOTIFICATION_EMAIL_PROVIDER=smtp    # smtp | console | mock (ses is a seam)
NOTIFICATION_SMS_PROVIDER=msg91     # msg91 | twilio | console | mock

# ------------------------------------------------------------
# FCM — real push transport (NOTIFICATION_PUSH_PROVIDER=fcm), using the
# Firebase Cloud Messaging HTTP v1 API with a Google service account.
# Either paste the fields below, or point SERVICE_ACCOUNT_PATH at the JSON file
# downloaded from Firebase Console → Project settings → Service accounts.
# ------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=                   # <name>@<project>.iam.gserviceaccount.com
FCM_PRIVATE_KEY=                    # PEM contents; in a shell, quote and keep \n literal
FCM_SERVICE_ACCOUNT_PATH=

# ------------------------------------------------------------
# Exports (Phase 4b)
# ------------------------------------------------------------
EXPORT_NIGHTLY_DAYS=7               # days of analytics the nightly job rebuilds/exports
EXPORT_NIGHTLY_HOUR=2               # local hour the nightly job is scheduled for

# ------------------------------------------------------------
# Media storage (Phase: media uploads)
# ------------------------------------------------------------
# local = bytes are PUT to this API and served from /media/local
#         (same-origin, authenticated, dev-friendly)
# s3    = presigned direct-to-bucket upload; the API never sees the bytes
#
# Production boot REFUSES local: every catalog image would live on one pod's
# disk and vanish on the next deploy, with nothing to serve them once there is
# more than one replica. Use s3 (or an S3-compatible endpoint such as MinIO),
# and the guard also requires the S3_* credentials below — an `s3` value with no
# bucket is a typo, not a configuration.
STORAGE_PROVIDER=local              # local | s3
LOCAL_STORAGE_DIR=storage/local     # relative to backend/ — keep OUT of git
MEDIA_PRESIGN_EXPIRY_SECONDS=900

# Size ceilings enforced at presign time (and again at confirm, with a
# magic-byte sniff so a renamed .exe cannot masquerade as a .png).
MEDIA_MAX_IMAGE_BYTES=10485760      # 10 MB
MEDIA_MAX_VIDEO_BYTES=262144000     # 250 MB
MEDIA_TENANT_QUOTA_BYTES=5368709120 # 5 GB per tenant; 0 = unlimited

# Required only when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                 # e.g. https://cdn.example.com (CloudFront in front of the bucket)

# ------------------------------------------------------------
# Marketplace (Phase 5)
# ------------------------------------------------------------
MARKETPLACE_ENABLED=true
MARKETPLACE_DEFAULT_COMMISSION_BPS=100   # 100 bps = 1% platform cut on vendor sales
MARKETPLACE_TRIAL_DAYS=14
MARKETPLACE_INVOICE_GRACE_DAYS=7         # days after period end until the invoice is due; the sweep flags it overdue past this date (single grace)
MARKETPLACE_INVOICE_GST_BPS=1800        # GST on platform invoices (fee + commission); 1800 bps = 18%; 0 disables
MARKETPLACE_NIGHTLY_DAYS=7               # days of platform rollup the nightly pass rebuilds
# Slugs that can never be registered as a store (they collide with product
# routes and, from Phase 6.4, with platform subdomains).
MARKETPLACE_RESERVED_SLUGS=www,api,admin,app,static,cdn,mail,help,support,status,blog,pay,checkout

# ------------------------------------------------------------
# Store onboarding (self-service registration)
# ------------------------------------------------------------
# registerStore() seeds an operational skeleton so a new store is not
# structurally incapable of taking an order. Serviceable PINCODES are never
# seeded — a merchant's delivery area is a business fact nobody can guess, and a
# wrong guess puts a store in front of customers it cannot serve. Pincodes are
# the first blocking item on the checklist instead (GET /marketplace/store/onboarding).
ONBOARDING_SEED_HUB=true
ONBOARDING_SEED_FEE_POLICY=true
ONBOARDING_HUB_NAME=Main hub
ONBOARDING_HUB_CODE=HUB-01          # unique per tenant
ONBOARDING_HUB_CAPACITY=25          # default slot capacity for the seeded hub
# The seeded fee policy starts at ZERO: free delivery until the merchant sets a
# real fee. The alternative silently charges their customers a number they never
# chose, which is what the hardcoded fallback below used to do.
ONBOARDING_DEFAULT_BASE_FEE=0
ONBOARDING_DEFAULT_FREE_THRESHOLD=  # empty = no threshold (nothing to cross at a ₹0 base)
ONBOARDING_DEFAULT_EXPRESS_SURGE=1
# Slots generated ahead at registration, and the horizon readiness checks.
ONBOARDING_SLOT_DAYS_AHEAD=3
# Refuse to flip store.isPublished while the store cannot take an order
# (400 STORE_NOT_READY, listing what is missing). Turn off only as an incident
# escape hatch — `ready` keeps reporting the truth either way.
ONBOARDING_REQUIRE_READY_TO_PUBLISH=true
# Last resort when a tenant has NO active DeliveryFeePolicy at all. This was a
# hardcoded `return 49` inside the file whose own header said it "Replaces the
# hardcoded deliveryFee = 49". Every use is counted in
# fm_pricing_fallback_total{kind="delivery_fee"} and warned once per tenant.
ONBOARDING_FALLBACK_DELIVERY_FEE=0

# Subscription/invoice charging. Leave as mock until a real biller is wired.
BILLING_PROVIDER=mock               # console | mock | razorpay

# ------------------------------------------------------------
# Financial ledger (Phase 6.1)
# ------------------------------------------------------------
# strict=true  -> a failed ledger post fails the calling operation
# strict=false -> the failure is logged and left to the idempotent
#                 backfill sweep (nightly). Defaults to true in
#                 production, false elsewhere.
LEDGER_STRICT=
# Force-disable multi-document transactions. Leave empty: the service
# probes the server at boot and uses transactions when the deployment
# is a replica set, logging which mode it chose.
LEDGER_DISABLE_TRANSACTIONS=
LEDGER_BASE_CURRENCY=INR

# ------------------------------------------------------------
# GST / tax invoicing (Phase 6.2)
# ------------------------------------------------------------
# Are catalogue prices tax-INCLUSIVE (Indian MRP convention) or exclusive?
# Inclusive is the default and the legally normal case for retail:
#   taxable = price × 10000 / (10000 + rateBps)
TAX_PRICES_INCLUSIVE=true
# Fallback GST state code when a supplier has no TaxRegistration yet
# (37 = Andhra Pradesh). Drives the intra-state CGST+SGST vs inter-state
# IGST decision together with the delivery address.
TAX_DEFAULT_STATE_CODE=37
# Invoice number series: PREFIX/FY/SEQ, e.g. FM/24-25/000123.
TAX_INVOICE_PREFIX=FM
TAX_CREDIT_NOTE_PREFIX=CN
TAX_NUMBER_WIDTH=6
# Month (1–12) the financial year starts. India = April.
TAX_FY_START_MONTH=4

# e-invoicing (IRN + signed QR from the IRP). console stamps a fake IRN,
# mock adds deterministic failures for testing retries, gsp calls a real
# GST Suvidha Provider. Only applies to suppliers above the turnover
# threshold with einvoiceEnabled set on their TaxRegistration.
EINVOICE_PROVIDER=console           # console | mock | gsp
EINVOICE_GSP_BASE_URL=
EINVOICE_GSP_API_KEY=
EINVOICE_GSP_API_SECRET=

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
# When true, DB-backed smoke suites FAIL instead of skipping if no
# MongoDB is reachable. Set this in CI.
REQUIRE_DB=
# Version of the in-memory mongod binary the hermetic suites download
# (mongodb-memory-server's own variable; CI pins it to 6.0.6). Leave unset
# locally to take the library default.
#
# MongoDB does not publish a binary for every version on every distro — 6.0.6
# has no Debian 12 build — so if the pin is unavailable for the detected OS,
# scripts/lib/hermeticMongo.js reads the minimum the library suggests and
# retries once with it, rather than failing all 22 suites at once. The download
# needs egress to fastdl.mongodb.org; without it the DB-backed suites cannot run
# at all and only the pure suites are available.
MONGOMS_VERSION=
# When "true", one-off migration scripts (e.g. scripts/seed-vendor-carry-views.mjs)
# log what they WOULD write without touching the database.
DRY_RUN=

# ------------------------------------------------------------
# Vendor payout disbursement (Phase 6.3 / M5)
# ------------------------------------------------------------
# console = logs the instruction and settles immediately (dev)
# mock    = deterministic outcomes keyed off the net amount's last two paise,
#           so every unhappy path is testable without credentials:
#             ...13 -> provider rejection (FAILED, safe to retry)
#             ...17 -> PAID, then the bank REVERSES it
#             ...99 -> AMBIGUOUS timeout; only reconciliation may resolve it
PAYOUT_PROVIDER=console             # console | mock | razorpayx | cashfree
# HMAC-SHA256 over the RAW webhook body, same scheme as the Razorpay payment
# webhook. REQUIRED in production — an unverified payout webhook lets anyone
# mark a batch as paid.
PAYOUT_WEBHOOK_SECRET=
# How long a batch may sit in PROCESSING before the reconciler asks the
# provider what actually happened. It is NEVER retried, only reconciled.
PAYOUT_RECONCILE_AFTER_MINUTES=15

RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=           # the RazorpayX virtual account money leaves from
RAZORPAYX_BASE_URL=https://api.razorpay.com/v1

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://payout-api.cashfree.com

# ------------------------------------------------------------
# Subdomain & custom-domain routing (Phase 6.4)
# ------------------------------------------------------------
# Off = pure header-based tenant resolution (pre-6.4 behaviour).
DOMAIN_ROUTING_ENABLED=true
# Stores are served at {slug}.{PLATFORM_ROOT_DOMAIN}. A wildcard certificate
# for *.{root} covers every store with no per-tenant work; custom domains use
# on-demand TLS gated by GET /internal/domains/allowed.
PLATFORM_ROOT_DOMAIN=flowermarket.in
# Trust `x-forwarded-host`. ONLY enable behind a proxy you control — an
# untrusted forwarded host is a tenant-spoofing vector.
TRUST_FORWARDED_HOST=false
# Allow `x-tenant-id` to override a Host that already resolved. A DEVELOPMENT
# affordance so one localhost can act as any tenant; defaults to false in
# production, where the hostname must win.
ALLOW_TENANT_HEADER_OVERRIDE=
# Resolve `<slug>.localhost` to the tenant with that slug. LOCAL DEVELOPMENT
# ONLY (default on outside production): test any number of stores via
# `http://<slug>.localhost:5174` with zero DNS/hosts-file setup — own
# hostname, own sessions, own carts, exactly like production subdomains.
ALLOW_LOCAL_SUBDOMAINS=
DOMAIN_RESOLUTION_CACHE_TTL_MS=300000
# Comma-separated IPs permitted to call the TLS `ask` hook. Empty = any (fine
# when the endpoint is only reachable from inside your network).
TLS_HOOK_IP_ALLOWLIST=

# ------------------------------------------------------------
# Search ranking (Phase 6.5)
# ------------------------------------------------------------
# mongo = $-query retrieval + in-process scoring, no new infrastructure. This
#         is production-grade and the guard accepts it.
# atlas / opensearch are declared seams with NO implementation — they throw on
#         first use, and production boot refuses them rather than letting the
#         catalog break at traffic time.
SEARCH_PROVIDER=mongo               # mongo | atlas | opensearch
SEARCH_DEFAULT_PROFILE=default
# % of queries written to the (PII-free, 90-day TTL) query log. Sampling keeps
# the write cost bounded on a busy store; 100 is fine until it isn't.
SEARCH_LOG_SAMPLE_PCT=100
# Serve GET /catalog from the ranked index. Set false to fall back to the
# legacy regex scan — the escape hatch if a ranking change goes wrong.
SEARCH_RANKED_CATALOG=true
# CI gate for scripts/search-eval.mjs. A tuning change that drops mean NDCG@10
# below this fails the build — measured baseline (legacy regex) is 0.569.
SEARCH_NDCG_GATE=0.85

# ------------------------------------------------------------
# Payments (Phase 7)
# ------------------------------------------------------------
# (Razorpay key/secret/webhook-secret are declared above with the
# notifications/payment section.) Leave them blank in dev to use the built-in
# mock provider — it simulates charge + refund + webhook with the same
# HMAC-SHA256 signature scheme Razorpay uses.
# Secret the MOCK provider signs webhooks with (see
# src/services/paymentProvider.service.js). Change per environment.
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-dev
# true = mock provider behaves like Razorpay's async capture: checkout
# returns a PENDING payment and the order stays in PAYMENT_PENDING until a
# signed webhook (or the reconcile job) confirms it. Dev/demo only.
MOCK_PAYMENT_PENDING=false
# Worker payment-reconcile cadence (ms). Re-polls the gateway for stale
# pending payments and pending refunds; safe under concurrency (at-most-
# one worker ticks the job at a time).
PAYMENT_RECONCILE_EVERY_MS=300000
# Pending payments older than this (minutes) are considered stale and
# resolved against the gateway (source of truth) on the next reconcile.
PAYMENT_PENDING_STALE_MINUTES=15
# Per-transaction wallet top-up bounds (INR). POST /wallet/topup charges via
# the provider first, then credits — it can never credit uncollected money.
WALLET_TOPUP_MIN_AMOUNT=10
WALLET_TOPUP_MAX_AMOUNT=5000

# ------------------------------------------------------------
# Worker runtime (Phase 7)
# ------------------------------------------------------------
# node src/worker.js — outbox consumer + scheduled jobs, separate from the
# API process. Multiple workers may run; claims are leased and atomic.
WORKER_ENABLED=true
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
# Hour (0-23) the built-in nightly jobs run (per-tenant nightly,
# marketplace nightly) in each worker's local time.
WORKER_NIGHTLY_HOUR=2

# ------------------------------------------------------------
# Observability (Phase 7)
# ------------------------------------------------------------
# Heartbeat cadence (ms) for API + worker liveness records.
OBS_HEARTBEAT_MS=15000
# /readyz treats the worker as alive if it heartbeated within this many
# seconds (0 disables the worker check).
OBS_WORKER_ALIVE_AFTER_SEC=45

# ------------------------------------------------------------
# Test / CI harness (read by backend/scripts/*.mjs, not the server)
# ------------------------------------------------------------
# Tenant the live E2E + payments-proof suites drive (otherwise they fall
# back to the seed default). scripts/ci/boot-live-stack.sh exports it.
FM_TENANT_ID=
# Where the API daemon writes its log; the live suites tail it for evidence.
# Unset = auto-detect (no tailing).
API_LOG_FILE=

# ------------------------------------------------------------
# Infrastructure (Phase 7.x additions)
# ------------------------------------------------------------
# IP allowlist for admin endpoints (comma-separated CIDRs; empty = allow all)
ADMIN_IP_ALLOWLIST=

# MongoDB advanced options
MONGO_COMPRESSORS=
MONGO_HEARTBEAT_FREQUENCY_MS=
MONGO_MAX_IDLE_TIME_MS=
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=
MONGO_READ_PREFERENCE=
MONGO_RETRY_READS=
MONGO_RETRY_WRITES=
MONGO_SERVER_SELECTION_TIMEOUT_MS=
MONGO_WAIT_QUEUE_TIMEOUT_MS=

# Redis (for queue service)
REDIS_URL=redis://localhost:6379

# TOTP (2FA secret for admin enrollment)
TOTP_SECRET=

# Webhook IP allowlist (comma-separated CIDRs)
WEBHOOK_IP_ALLOWLIST=

# OpenTelemetry (see observability/otel.js)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=flowermarket
OTEL_EXPORTER_URL=http://localhost:4318
OTEL_SAMPLE_RATE=0.1
